
#include <stdio.h>
#include <stdlib.h>
#include <math.h>

#define TAM 100
#define POSICOES 10

// =====================================================
// EXERCICIO 1 - VETOR INVERSO E ORDEM DECRESCENTE
// =====================================================

void exercicio1()
{
    int vetor[TAM];
    int ordenado[TAM];
    int i, j, aux;

    // Leitura dos 100 numeros
    for (i = 0; i < TAM; i++)
    {
        printf("Digite o %d numero: ", i + 1);
        scanf("%d", &vetor[i]);

        ordenado[i] = vetor[i];
    }

    // Impressao na ordem inversa
    printf("\nNumeros na ordem inversa:\n");

    for (i = TAM - 1; i >= 0; i--)
    {
        printf("%d ", vetor[i]);
    }

    // Ordenacao do maior para o menor
    for (i = 0; i < TAM - 1; i++)
    {
        for (j = 0; j < TAM - 1 - i; j++)
        {
            if (ordenado[j] < ordenado[j + 1])
            {
                aux = ordenado[j];
                ordenado[j] = ordenado[j + 1];
                ordenado[j + 1] = aux;
            }
        }
    }

    // Impressao do vetor ordenado
    printf("\n\nNumeros em ordem decrescente:\n");

    for (i = 0; i < TAM; i++)
    {
        printf("%d ", ordenado[i]);
    }

    printf("\n");
}

// =====================================================
// EXERCICIO 2 - NOTACAO CIENTIFICA
// =====================================================

void exercicio2()
{
    double numero, mantissa;
    int expoente = 0;

    printf("Digite um numero positivo: ");
    scanf("%lf", &numero);

    if (numero <= 0)
    {
        printf("Digite um numero maior que zero!\n");
        return;
    }

    mantissa = numero;

    // Ajusta o numero para ficar entre 1 e 10
    while (mantissa >= 10)
    {
        mantissa = mantissa / 10;
        expoente++;
    }

    while (mantissa < 1)
    {
        mantissa = mantissa * 10;
        expoente--;
    }

    printf("\nNotacao cientifica: %.6lf x 10^%d\n",
           mantissa, expoente);
}

// =====================================================
// EXERCICIO 3 - CONVERSAO PARA BASE BINARIA
// =====================================================

void exercicio3()
{
    int numero, i;
    int bits[7];

    printf("Digite um numero entre 1 e 64: ");
    scanf("%d", &numero);

    if (numero < 1 || numero > 64)
    {
        printf("Numero invalido!\n");
        return;
    }

    // Armazena os restos das divisoes por 2
    for (i = 0; i < 7; i++)
    {
        bits[i] = numero % 2;
        numero = numero / 2;
    }

    // Imprime os bits na ordem correta
    printf("Valor em binario: ");

    for (i = 6; i >= 0; i--)
    {
        printf("%d", bits[i]);
    }

    printf("\n");
}

// =====================================================
// EXERCICIO 4 - MAIOR DE 10 NUMEROS
// =====================================================

// Funcao que calcula o maior entre dois numeros
int maiorDois(int a, int b)
{
    return (a + b + abs(a - b)) / 2;
}

void exercicio4()
{
    int vetor[10];
    int maior;
    int i;

    // Leitura dos dez valores
    for (i = 0; i < 10; i++)
    {
        printf("Digite o %d valor: ", i + 1);
        scanf("%d", &vetor[i]);
    }

    // Inicializa com o primeiro valor
    maior = vetor[0];

    // Compara os valores utilizando a funcao
    for (i = 1; i < 10; i++)
    {
        maior = maiorDois(maior, vetor[i]);
    }

    printf("\n%d eh o maior\n", maior);
}

// =====================================================
// EXERCICIO 5 - PARIDADE E PRIMALIDADE
// =====================================================

// Funcao para verificar se o numero e par
int verificarParidade(int numero)
{
    if (numero % 2 == 0)
    {
        return 1;
    }
    else
    {
        return 0;
    }
}

// Funcao para verificar se o numero e primo
int verificarPrimo(int numero)
{
    int i;

    if (numero < 2)
    {
        return 0;
    }

    for (i = 2; i <= numero / i; i++)
    {
        if (numero % i == 0)
        {
            return 0;
        }
    }

    return 1;
}

void exercicio5()
{
    int vetor[TAM];
    int i;

    // Leitura dos 100 numeros
    for (i = 0; i < TAM; i++)
    {
        printf("Digite o %d numero: ", i + 1);
        scanf("%d", &vetor[i]);
    }

    // Verifica a paridade e a primalidade
    printf("\nRESULTADOS:\n");

    for (i = 0; i < TAM; i++)
    {
        printf("\nNumero: %d\n", vetor[i]);

        if (verificarParidade(vetor[i]))
        {
            printf("Paridade: PAR\n");
        }
        else
        {
            printf("Paridade: IMPAR\n");
        }

        if (verificarPrimo(vetor[i]))
        {
            printf("Primalidade: PRIMO\n");
        }
        else
        {
            printf("Primalidade: NAO PRIMO\n");
        }
    }
}

// =====================================================
// EXERCICIO 6 - DISTANCIA EUCLIDIANA
// =====================================================

void exercicio6()
{
    float x1[POSICOES];
    float y1[POSICOES];
    float x2[POSICOES];
    float y2[POSICOES];

    float distancia;
    int i;

    // Leitura das coordenadas do primeiro ponto
    printf("COORDENADAS DO PRIMEIRO PONTO:\n");

    for (i = 0; i < POSICOES; i++)
    {
        printf("Digite x1[%d]: ", i + 1);
        scanf("%f", &x1[i]);

        printf("Digite y1[%d]: ", i + 1);
        scanf("%f", &y1[i]);
    }

    // Leitura das coordenadas do segundo ponto
    printf("\nCOORDENADAS DO SEGUNDO PONTO:\n");

    for (i = 0; i < POSICOES; i++)
    {
        printf("Digite x2[%d]: ", i + 1);
        scanf("%f", &x2[i]);

        printf("Digite y2[%d]: ", i + 1);
        scanf("%f", &y2[i]);
    }

    // Calcula a distancia entre os dez pares de pontos
    printf("\nDISTANCIAS EUCLIDIANAS:\n");

    for (i = 0; i < POSICOES; i++)
    {
        distancia = sqrt(
            pow(x2[i] - x1[i], 2) +
            pow(y2[i] - y1[i], 2)
        );

        printf("Distancia entre os pontos %d: %.2f\n",
               i + 1, distancia);
    }
}

// =====================================================
// EXERCICIO 7 - NUMEROS CONSECUTIVOS NO VETOR
// =====================================================

void exercicio7()
{
    int vetor[TAM];
    int i;
    int encontrou = 0;

    // Leitura dos 100 numeros
    for (i = 0; i < TAM; i++)
    {
        printf("Digite o %d numero: ", i + 1);
        scanf("%d", &vetor[i]);
    }

    // Verifica se existem numeros consecutivos
    // em posicoes vizinhas do vetor
    printf("\nNUMEROS CONSECUTIVOS:\n");

    for (i = 0; i < TAM - 1; i++)
    {
        if ((long long)vetor[i] + 1 == vetor[i + 1])
        {
            printf("%d e %d\n", vetor[i], vetor[i + 1]);
            encontrou = 1;
        }
    }

    if (encontrou == 0)
    {
        printf("Nao foram encontrados numeros consecutivos.\n");
    }
}

